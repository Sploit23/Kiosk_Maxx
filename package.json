{
  "name": "kiosk-eletron",
  "version": "1.0.0",
  "description": "Kiosk de Fotos",
  "author": "Sploit",
  "main": "src/electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "kiosk": "electron . --kiosk",
    "server": "node src/server/server-simple.js",
    "build:win": "electron-builder --win",
    "build:win:portable": "electron-builder --win portable",
    "dev:packaged": "set KIOSK_FORCE_PACKAGED=1 && electron .",
    "kill-processes": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Get-Process | ? { $_.Name -in 'Kiosk de Fotos','electron','node' } | % { Stop-Process -Id $_.Id -Force -ErrorAction SilentlyContinue }\"",
    "clean:build": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"if (Test-Path 'build\\win-unpacked') { Remove-Item 'build\\win-unpacked' -Recurse -Force }\"",
    "release:portable": "npm run kill-processes && npm run clean:build && node .\\node_modules\\electron-builder\\out\\cli\\cli.js --win portable && powershell -NoProfile -ExecutionPolicy Bypass -Command \"$ts = Get-Date -Format 'yyyyMMdd-HHmm'; $dest = Join-Path 'releases' $ts; New-Item -ItemType Directory -Force -Path $dest | Out-Null; Copy-Item -Recurse -Force 'build\\win-unpacked' $dest\"",
    "build:win:nsis": "electron-builder --win nsis",
    "release:nsis": "npm run kill-processes && npm run clean:build && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "build": {
    "appId": "com.kiosk.photos",
    "productName": "Kiosk de Fotos",
    "directories": {
      "output": "build",
      "buildResources": "build-resources"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName} ${target}.${ext}",
      "signAndEditExecutable": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Sploit23",
        "repo": "kiosk-updates"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false
    }
  }
}
