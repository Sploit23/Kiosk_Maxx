{
  "name": "natal-kiosk",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "start": "npm run electron:dev",
    "dev": "vite",
    "build": "vite build",
    "build:win": "vite build && electron-builder --win",
    "release": "vite build && electron-builder --win --publish always",
    "lint": "eslint .",
    "electron:dev": "concurrently \"vite\" \"wait-on tcp:5173 && electron .\""
  },
  "build": {
    "appId": "com.maxx.natal-kiosk",
    "productName": "Maxx Foto Vendas",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "preload.cjs",
      "electron-config.template.json",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "impressora",
        "to": "impressora"
      },
      {
        "from": "public",
        "to": "public"
      },
      {
        "from": "sidecar/natal-core.cjs",
        "to": "natal-core.cjs"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": null,
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asar": true,
    "publish": {
      "provider": "github",
      "owner": "Sploit23",
      "repo": "Kiosk_Maxx"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "exifr": "^7.1.3",
    "globals": "^6.1.0",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10"
  }
}
